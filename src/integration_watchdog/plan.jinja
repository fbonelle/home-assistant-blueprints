{% set now_ts = clock_ts | int %}
{% set boot = as_timestamp(states(uptime_entity),now_ts) | int %}
{% set period = (scan_minutes[1:] | int) * 60 %}
{% set history = memory.get('a',[]) | select('gt',now_ts - 86400) | list %}
{% set old_status = memory.get('s','new') %}
{% set old_notice = memory.get('k','') %}
{% set ns = namespace(a=history,i=memory.get('i',0),n=memory.get('n',0),p=memory.get('p',0),f=memory.get('f',0),h=memory.get('h',0),s=old_status,reason='',reload=false,notice='none') %}
{% if boot > memory.get('t',0) or now_ts - memory.get('t',0) > period * 2 + 30 %}
  {% set ns.h = 0 %}
{% endif %}
{# Reload cut short by a stop of the run while the entry stayed unloaded: resume it. #}
{% set force = old_status == 'interrupted' %}
{% if trigger is defined and trigger.id == 'availability' %}{% set ns.h = 0 %}{% endif %}
{% set entry_state = config_entry_attr(row.entry_id,'state') %}
{% set domain = config_entry_attr(row.entry_id,'domain') %}
{% set auth = ('homeassistant','config_entry_reauth_' ~ domain ~ '_' ~ row.entry_id) in issues() %}
{% set startup_ok = now_ts - boot >= startup_seconds %}
{% set alarm = false %}
{% if old_status == 'native' and entry_state == 'loaded' %}
  {% set ns.n = 0 %}
{% endif %}
{% set force = force and entry_state == 'not_loaded' %}
{% if auth %}
  {% set ns.h = 0 %}
  {% set ns.s = 'auth' %}
  {% set ns.reason = 'Reauthentication is required. Renew the connection in Home Assistant; no automatic reload.' %}
  {% set alarm = true %}
{% elif config_entry_attr(row.entry_id,'disabled_by') is not none %}
  {% set ns.h = 0 %}
  {% set ns.s = 'disabled' %}
  {% set ns.reason = 'This integration configuration is disabled.' %}
{% elif not startup_ok %}
  {% set ns.h = 0 %}
  {% set ns.s = 'startup' %}
  {% set ns.reason = 'Waiting after Home Assistant start-up.' %}
{% elif entry_state in ['migration_error','failed_unload','setup_error','not_loaded'] and not force %}
  {% set ns.h = 0 %}
  {% set ns.s = 'fatal' %}
  {% set ns.reason = 'State ' ~ entry_state ~ ': manual intervention needed; no forced reload.' %}
  {% set alarm = true %}
{% elif config_entry_attr(row.entry_id,'pref_disable_polling') %}
  {% set ns.h = 0 %}
  {% set ns.n = 0 %}
  {% set ns.s = 'native' %}
  {% set ns.reason = 'Polling deliberately disabled; no forced reload.' %}
{% elif entry_state != 'loaded' and not force %}
  {% set ns.h = 0 %}
  {% if old_status != 'native' or ns.n == 0 %}{% set ns.n = now_ts + native_timeout %}{% endif %}
  {% set ns.s = 'native' %}
  {% set ns.reason = 'Home Assistant is already trying to reconnect the integration.' %}
  {% if now_ts >= ns.n %}
    {% set ns.reason = 'The reconnection handled by Home Assistant is taking too long. Check the errors of the integration.' %}
    {% set alarm = true %}
  {% endif %}
{% elif health.source_invalid %}
  {% set ns.h = 0 %}
  {% set ns.s = 'fatal' %}
  {% set ns.reason = 'The source timestamp is missing or inconsistent: check where it comes from and the clock. Reloads suspended.' %}
  {% set alarm = true %}
{% elif health.recovered %}
  {% if ns.h == 0 %}
    {% set ns.h = now_ts %}
  {% endif %}
  {% if now_ts - ns.h >= stable_seconds %}
    {% set ns.s = 'healthy' %}
    {% set ns.reason = 'Every watched entity has been working for the planned confirmation time.' %}
    {% if old_notice != '' or (old_status != 'healthy' and ns.i > 0) %}
      {% set ns.notice = 'success' %}
    {% endif %}
    {% if now_ts - ns.h >= incident_reset_seconds %}
      {% set ns.i = 0 %}
    {% endif %}
    {% set ns.n = 0 %}
  {% else %}
    {% set ns.reason = 'The entities are available again. Waiting for the recovery to be confirmed.' %}
    {% if ns.s != 'verify' %}{% set ns.s = 'degraded' %}{% endif %}
  {% endif %}
{% else %}
  {% set ns.h = 0 %}
  {% if ns.s == 'verify' and now_ts < ns.n %}
    {% set ns.reason = 'Waiting for the data to come back after the reload.' %}
  {% elif ns.s == 'verify' %}
    {% set ns.s = 'waiting' %}
    {% set ns.n = now_ts + [retry_seconds * (2 ** ([ns.i - 1,0] | max)),max_backoff] | min + row.get('stagger_seconds',0) %}
    {% set ns.reason = 'The expected data did not come back. A new attempt will be offered after the planned delay.' %}
    {% if ns.i >= max_attempts %}
      {% set ns.s = 'suspended' %}
      {% set ns.reason = 'The maximum number of attempts for this failure is reached. Reloads are suspended until a lasting recovery or a manual reset.' %}
      {% set alarm = true %}
    {% endif %}
  {% elif not health.fault and not force and not (ns.i > 0 and old_status in ['verify','waiting','running','limited','suspended','timeout']) %}
    {% set ns.s = 'degraded' %}
    {% set ns.reason = 'Some entities are failing, but the reload conditions are not met yet.' %}
  {% elif ns.i >= max_attempts %}
    {% set ns.s = 'suspended' %}
    {% set ns.reason = 'The maximum number of attempts for this failure is reached. Reloads are suspended until a lasting recovery or a manual reset.' %}
    {% set alarm = true %}
  {% elif not interventions_allowed %}
    {% set ns.s = 'observation' if observation_only else 'paused' %}
    {% set ns.reason = 'Observation only; no new reload request.' if observation_only else 'Interventions suspended by the extra conditions.' %}
  {% elif ns.a | count >= max_daily %}
    {% set ns.s = 'limited' %}
    {% set ns.n = (ns.a | min) + 86400 %}
    {% set ns.reason = 'The maximum number of attempts over the last 24 hours is reached. Reloads will resume when this limit allows it.' %}
    {% set alarm = true %}
  {% elif now_ts < ns.n %}
    {% set ns.s = 'waiting' %}
    {% set ns.reason = 'Pause before the next allowed request.' %}
  {% elif old_status not in ['waiting','limited','suspended','verify'] and ns.i == 0 and row.get('stagger_seconds',0) > 0 %}
    {% set ns.s = 'waiting' %}
    {% set ns.n = now_ts + row.get('stagger_seconds',0) %}
    {% set ns.reason = 'Initial offset between integrations.' %}
  {% else %}
    {% set ns.s = 'running' %}
    {% set ns.p = reservation_ts %}
    {% set ns.f = 0 %}
    {% set ns.reload = true %}
    {% set ns.reason = 'Resuming the interrupted reload: the integration stayed unloaded.' if force else 'Reloading the integration. The attempt is counted when it starts.' %}
  {% endif %}
{% endif %}
{% if alarm and old_notice != ns.s %}{% set ns.notice = 'failure' %}{% endif %}
{% set data = {'v':3,'o':owner_id,'e':entry_key,'a':ns.a,'i':ns.i,'n':ns.n,'p':ns.p,'f':ns.f,'h':ns.h,'t':now_ts,'s':ns.s,'k':old_notice} %}
{% set acknowledged = dict(data,k=(ns.s if ns.notice == 'failure' else '' if ns.notice == 'success' else old_notice)) %}
{{ {'memory':data,'acknowledged':acknowledged,'reload':ns.reload,'force':force,'notice':ns.notice,'reason':ns.reason,'status':ns.s,'bad':health.bad,'attempts':ns.i,'daily':ns.a | count} }}
