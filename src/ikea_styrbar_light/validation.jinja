{% set ns=namespace(errors=[]) %}
{% if not lamp.startswith('light.') or not remote %}
 {% set ns.errors=ns.errors+['Choisir une lampe et une télécommande.'] %}
{% endif %}
{% set modes=state_attr(lamp,'supported_color_modes') or [] %}
{% if modes|select('in',['xy','hs','rgb','rgbw','rgbww'])|list|count == 0 %}
 {% set ns.errors=ns.errors+['La lampe doit prendre en charge les couleurs.'] %}
{% endif %}
{% if not memory_entity.startswith('input_text.') or states[memory_entity] is none or raw == 'unavailable'
 or state_attr(memory_entity,'min') != 0 or state_attr(memory_entity,'max') != 255 %}
 {% set ns.errors=ns.errors+['Créer un assistant Texte distinct, de longueur minimale 0 et maximale 255.'] %}
{% endif %}
{% if palette is not sequence or palette is string or palette is mapping or palette|count == 0
 or palette|count > catalog|count %}
 {% set ns.errors=ns.errors+['La palette doit être une liste non vide sans doublons.'] %}
{% else %}
 {% for key in palette %}{% if key is not string or key not in catalog %}
  {% set ns.errors=ns.errors+['La palette contient un préréglage inconnu.'] %}
 {% elif key in palette[:loop.index0] %}
  {% set ns.errors=ns.errors+['La palette contient des doublons.'] %}
 {% endif %}{% endfor %}
{% endif %}
{% if default_color is not sequence or default_color is string or default_color|count != 3 %}
 {% set ns.errors=ns.errors+['La couleur de rappel doit contenir trois composantes RGB.'] %}
{% else %}{% for v in default_color %}
 {% if v is not number or v is boolean or not 0 <= v <= 255 or v != v|int %}
  {% set ns.errors=ns.errors+['Chaque composante RGB doit être un entier de 0 à 255.'] %}
 {% endif %}{% endfor %}
 {% if default_color|select('number')|list|count == 3 and default_color|sum == 0 %}
  {% set ns.errors=ns.errors+['Choisir une couleur de rappel lumineuse, différente du noir.'] %}
 {% endif %}
{% endif %}
{% for value,lower,upper in [(brightness_step,1,25),(min_brightness,1,100),(max_brightness,1,100),
 (on_brightness,0,100),(dim_interval,1,5),(hold_limit,2,30),(transition,0,2),
 (double_press_ms,250,1500),(debounce_ms,0,200)] %}
 {% if value is not number or value is boolean or not lower <= value <= upper %}
  {% set ns.errors=ns.errors+['Un réglage numérique dépasse ses limites.'] %}
 {% endif %}
{% endfor %}
{% if (min_brightness is number and max_brightness is number and min_brightness > max_brightness) or
 (debounce_ms is number and double_press_ms is number and debounce_ms >= double_press_ms) or
 recall_fallback not in ['right_hold','left_hold','none'] or
 colors_turn_on is not boolean or recall_turns_on is not boolean or logging is not boolean %}
 {% set ns.errors=ns.errors+['Les réglages de variation ou de rappel sont incohérents.'] %}
{% endif %}
{% if raw not in ['','unknown'] %}
 {% set m=raw[4:]|from_json(none) if raw.startswith('sl1:') else none %}
 {% if m is not mapping or m.get('v') is not integer or m.v != 1 or m.get('o') != owner %}
  {% set ns.errors=ns.errors+['L’assistant Texte est illisible ou appartient à une autre automatisation. Ne pas le partager.'] %}
 {% else %}
  {% if m.keys()|list|sort != ['c','h','i','k','o','p','s','t','u','v','x'] or
   m.get('c') not in ['','on','off','left','right','up_hold','down_hold','left_hold','right_hold','release','paired'] or
   m.get('h') not in ['','up','down'] or m.get('i') is not integer or not -1 <= m.i < catalog|count or
   m.get('k') is not string or m.k|length not in [0,8] or m.get('p') is not string or m.p|length not in [0,8] %}
   {% set ns.errors=ns.errors+['L’état des boutons est invalide ; vider cet assistant lorsque l’automatisation est arrêtée.'] %}
  {% endif %}
  {% for k in ['t','s','u'] %}
   {% set v=m.get(k) %}
   {% if v is not number or v is boolean or not 0 <= v <= 7258118400 %}
    {% set ns.errors=ns.errors+['Horodatage invalide dans l’assistant Texte.'] %}
   {% endif %}
  {% endfor %}
  {% set x=m.get('x') %}
  {% if x is not sequence or x is string or x is mapping or x|count not in [0,2] %}
   {% set ns.errors=ns.errors+['Coordonnées de couleur invalides dans l’assistant Texte.'] %}
  {% else %}{% for value in x %}{% if value is not number or value is boolean or not 0 <= value <= 1 %}
   {% set ns.errors=ns.errors+['Coordonnées de couleur invalides dans l’assistant Texte.'] %}
  {% endif %}{% endfor %}{% endif %}
 {% endif %}
{% endif %}
{{ ns.errors|unique|list }}
